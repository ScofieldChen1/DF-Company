# Vercel：Settings → Environment Variables（勿提交到 GitHub）
# 本地开发：复制为 server/.env

PORT=8765

# ========== 邮件通知（必填，QQ 邮箱示例）==========
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=851009112@qq.com
SMTP_PASS=在QQ邮箱设置里生成的16位授权码
SMTP_FROM_NAME=东方磨具官网询盘
NOTIFY_EMAIL=851009112@qq.com

