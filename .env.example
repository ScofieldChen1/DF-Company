# Vercel：Settings → Environment Variables（勿提交到 GitHub）
# 本地开发：复制为 server/.env

PORT=8765

# ========== 邮件通知（二选一）==========
#
# 【推荐 · Vercel 生产环境】Resend HTTPS API（海外节点可直连，免费 100 封/天）
# 注册 https://resend.com → API Keys → 填入下方；收件邮箱填 NOTIFY_EMAIL
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Orient Abrasives <onboarding@resend.dev>
# NOTIFY_EMAIL=CJ711226@163.com
#
# 【仅本地 / 自有服务器】QQ SMTP（Vercel 上常会 ETIMEDOUT，勿用于线上）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=851009112@qq.com
# SMTP_PASS=在QQ邮箱设置里生成的16位授权码
# SMTP_FROM_NAME=东方磨具官网询盘
# NOTIFY_EMAIL=CJ711226@163.com

RESEND_API_KEY=
RESEND_FROM=Orient Abrasives <onboarding@resend.dev>
NOTIFY_EMAIL=CJ711226@163.com

# ========== 短信（可选，暂不配置可留空）==========
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# NOTIFY_PHONE=
