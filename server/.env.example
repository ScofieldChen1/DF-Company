# 服务端口（与网站预览一致）
PORT=8765

# ========== 邮件通知（SMTP）==========
# 示例：QQ 邮箱 smtp.qq.com / 163 邮箱 smtp.163.com / 企业邮箱
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password-or-authorization-code

# 发件人显示名
SMTP_FROM_NAME=东方磨具官网询盘

# 收到询盘提醒的邮箱（可填多个，英文逗号分隔）
NOTIFY_EMAIL=owner@example.com

# ========== 短信通知（阿里云短信）==========
# 在 https://ram.console.aliyun.com/ 创建 AccessKey
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 短信签名（需在阿里云短信控制台审核通过）
ALIYUN_SMS_SIGN_NAME=东方磨具

# 短信模板 CODE（模板需含变量 content，例如：您有新的官网询盘：${content}）
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

# 收到短信提醒的手机号（国内 11 位，可多个英文逗号分隔）
NOTIFY_PHONE=13800138000
